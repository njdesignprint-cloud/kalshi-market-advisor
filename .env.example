# Copia este archivo a ".env" y completa tus propios valores.
# NUNCA subas tu archivo ".env" real a un repositorio.

# Identificador de tu API key de Kalshi (seccion "API Keys" de tu perfil).
# Para los mercados (analisis, dashboard) es opcional: esos datos son
# publicos y funcionan sin autenticacion, aunque autenticarte te da
# limites de tasa mas altos. Para la seccion "Mi Portafolio" (ver tu
# balance y posiciones reales) SI es obligatorio.
KALSHI_API_KEY_ID=

# Ruta local al archivo .pem de la clave privada RSA asociada a esa API key.
# Ejemplo: KALSHI_PRIVATE_KEY_PATH=C:\Users\tu_usuario\.kalshi\private_key.pem
KALSHI_PRIVATE_KEY_PATH=

# Opcional: sobrescribe la URL base de la API de Kalshi.
# Produccion (por defecto): https://external-api.kalshi.com
# Demo/sandbox: https://external-api.demo.kalshi.co
KALSHI_API_BASE_URL=
